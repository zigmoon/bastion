root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

[*.{md,markdown,txt,yml,yaml,json,pot}]
indent_style = space
indent_size = 2

[*.po]
indent_style = space
indent_size = 4

[*.svg]
indent_style = tab
indent_size = 1

[*.ps1]
indent_style = tab
indent_size = 4
