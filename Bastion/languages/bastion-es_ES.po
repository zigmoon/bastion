#: Bastion/includes/class-audit.php:733
msgid "%1$d passed, %2$d warnings, %3$d failed"
msgstr "%1$d superados, %2$d a revisar, %3$d fallidos"

#: Bastion/includes/class-admin.php:642
msgid "-all — hard fail, only the listed servers may send"
msgstr "-all — fallo estricto, solo los servidores listados pueden enviar"

#: Bastion/includes/class-admin.php:534
msgid "180 days is the usual target (15552000). A first deployment can use 3600 for an hour, or 86400 for a day."
msgstr "180 días es el objetivo habitual (15552000). Un primer despliegue puede usar 3600 durante una hora, o 86400 durante un día."

#: Bastion/includes/class-admin.php:512
msgid "301 is what search engines expect for a definitive move to HTTPS."
msgstr "301 es lo que esperan los buscadores para un paso definitivo a HTTPS."

#: Bastion/includes/class-admin.php:643
msgid "?all — neutral, no position taken"
msgstr "?all — neutro, sin tomar posición"

#: Bastion/includes/class-admin.php:529
msgid "A browser that has seen the header refuses plain HTTP for the whole max-age, even if you remove the header afterwards. Start with a short max-age, confirm the site is stable for a week, then raise it."
msgstr "Un navegador que ha visto la cabecera rechaza el HTTP en claro durante todo el max-age, aunque la retire después. Empieza con un max-age corto, comprueba que el sitio aguanta una semana y luego auméntalo."

#: Bastion/includes/class-admin.php:445
msgid "A hardening plugin that acts the moment it is activated is a liability. Audit mode is the default, and the audit screen shows exactly what apply would change."
msgstr "Un plugin de endurecimiento que actúa nada más activarse es un riesgo. El modo auditoría es el predeterminado, y la pantalla de auditoría muestra exactamente qué cambiaría al aplicar."

#: Bastion/includes/class-audit.php:327
msgid "A max-age below 180 days is a transitional value."
msgstr "Un max-age inferior a 180 días es un valor de transición."

#: Bastion/includes/class-admin.php:623
msgid "A plugin cannot write DNS"
msgstr "Un plugin no puede escribir en el DNS"

#: Bastion/includes/class-admin.php:382
msgid "Active"
msgstr "Activo"

#: Bastion/includes/class-admin.php:777
msgid "Activity"
msgstr "Actividad"

#: Bastion/includes/class-admin.php:271
msgid "Activity log cleared."
msgstr "Registro de actividad vaciado."

#: Bastion/includes/class-audit.php:337
msgid "Add define( 'FORCE_SSL_ADMIN', true ); to wp-config.php — the login cookie is worth as much as the password."
msgstr "Añade define( 'FORCE_SSL_ADMIN', true ); en wp-config.php — la cookie de acceso vale tanto como la contraseña."

#: Bastion/includes/class-admin.php:487
msgid "Add this line to wp-config.php to stop every change without touching the database:"
msgstr "Añade esta línea en wp-config.php para detener todos los cambios sin tocar la base de datos:"

#: Bastion/includes/class-admin.php:536
msgid "Add “preload”"
msgstr "Añadir «preload»"

#: Bastion/includes/class-audit.php:332
msgid "Admin forced over HTTPS"
msgstr "Administración forzada por HTTPS"

#: Bastion/includes/class-admin.php:576
msgid "An https URL that receives the violation reports. Leave empty to keep the reports in the browser console only."
msgstr "Una URL https que recibe los informes de violación. Déjala vacía para mantenerlos solo en la consola del navegador."

#: Bastion/includes/class-admin.php:616
msgid "Announces the PHP version. Best removed in php.ini (expose_php = Off); this covers the rest."
msgstr "Anuncia la versión de PHP. Lo mejor es quitarla en php.ini (expose_php = Off); esto cubre el resto."

#: Bastion/includes/class-admin.php:615
msgid "Announces the XML-RPC endpoint on every response."
msgstr "Anuncia el punto de acceso XML-RPC en cada respuesta."

#: Bastion/includes/class-admin.php:617
msgid "Answer 404 for readme.html"
msgstr "Responder 404 para readme.html"

#: Bastion/includes/class-admin.php:582 Bastion/includes/class-audit.php:383
msgid "Anti-clickjacking"
msgstr "Anti-clickjacking"

#: Bastion/includes/class-admin.php:443
msgid "Apply — the switches below take effect"
msgstr "Aplicar — los interruptores de abajo surten efecto"

#: Bastion/includes/class-admin.php:420
msgid "Applying"
msgstr "Aplicando"

#: Bastion/includes/class-admin.php:480
msgid "Asks github.com for the latest release once every 12 hours, and shows it on the Plugins and Updates screens. It is the only outbound request the plugin makes: switch it off to keep the plugin fully offline and update by hand."
msgstr "Consulta github.com una vez cada 12 horas para conocer la última versión y la muestra en las pantallas de Plugins y Actualizaciones. Es la única petición saliente del plugin: desactívala para mantenerlo totalmente sin conexión y actualizar a mano."

#: Bastion/includes/class-audit.php:533
msgid "Asset versions hidden"
msgstr "Versiones de recursos ocultas"

#: Bastion/includes/class-admin.php:408
msgid "Audit"
msgstr "Auditoría"

#: Bastion/includes/class-admin.php:279
msgid "Audit complete: the report below was measured on the live site just now."
msgstr "Auditoría completada: el informe de abajo se acaba de medir en el sitio en vivo."

#: Bastion/includes/class-admin.php:420
msgid "Audit only"
msgstr "Solo auditoría"

#: Bastion/includes/class-admin.php:442
msgid "Audit only — measure, change nothing"
msgstr "Solo auditoría — medir, no cambiar nada"

#: Bastion/includes/class-admin.php:74 Bastion/includes/class-admin.php:75
msgid "Bastion"
msgstr "Bastion"

#: Bastion/includes/class-admin.php:316
msgid "Bastion %1$s — a plugin by %2$s, dev by %3$s."
msgstr "Bastion %1$s — un plugin de %2$s, desarrollo de %3$s."

#: Bastion/includes/class-admin.php:289
msgid "Bastion is in audit mode."
msgstr "Bastion está en modo auditoría."

#: Bastion/includes/class-admin.php:403
msgid "Bastion sections"
msgstr "Secciones de Bastion"

#: Bastion/includes/class-audit.php:536
msgid "Bastion → Disclosures → asset versions."
msgstr "Bastion → Divulgaciones → versiones de recursos."

#: Bastion/includes/class-audit.php:526
msgid "Bastion → Disclosures → generator."
msgstr "Bastion → Divulgaciones → generador."

#: Bastion/includes/class-audit.php:516
msgid "Bastion → Disclosures, or expose_php = Off in php.ini."
msgstr "Bastion → Divulgaciones, o expose_php = Off en php.ini."

#: Bastion/includes/class-audit.php:327
msgid "Bastion → HTTPS → HSTS, once HTTPS is confirmed working."
msgstr "Bastion → HTTPS → HSTS, cuando el HTTPS esté confirmado."

#: Bastion/includes/class-audit.php:297
msgid "Bastion → HTTPS → force, or a server-level redirect."
msgstr "Bastion → HTTPS → forzar, o una redirección en el servidor."

#: Bastion/includes/class-audit.php:377
msgid "Bastion → Headers → policy."
msgstr "Bastion → Cabeceras → política."

#: Bastion/includes/class-admin.php:515
msgid "Behind a proxy"
msgstr "Detrás de un proxy"

#: Bastion/includes/class-admin.php:805
msgid "Changes apply immediately."
msgstr "Los cambios se aplican al instante."

#: Bastion/includes/class-admin.php:751 Bastion/includes/class-audit.php:748
msgid "Check"
msgstr "Comprobación"

#: Bastion/includes/class-admin.php:480
msgid "Check GitHub for updates"
msgstr "Buscar actualizaciones en GitHub"

#: Bastion/includes/class-admin.php:675
msgid "Choose a mail provider, or type a custom source, to generate the record."
msgstr "Elige un proveedor de correo, o escribe una fuente personalizada, para generar el registro."

#: Bastion/includes/class-admin.php:359
msgid "Choose…"
msgstr "Elegir…"

#: Bastion/includes/class-audit.php:292
msgid "Clear text redirects to HTTPS"
msgstr "El texto plano redirige a HTTPS"

#: Bastion/includes/class-admin.php:812
msgid "Clear the log"
msgstr "Vaciar el registro"

#: Bastion/includes/class-admin.php:544 Bastion/includes/class-audit.php:362 Bastion/includes/class-audit.php:366 Bastion/includes/class-audit.php:374
msgid "Content-Security-Policy"
msgstr "Content-Security-Policy"

#: Bastion/includes/class-admin.php:607
msgid "Cross-Origin-Opener-Policy"
msgstr "Cross-Origin-Opener-Policy"

#: Bastion/includes/class-admin.php:565
msgid "Custom"
msgstr "Personalizada"

#: Bastion/includes/class-admin.php:634
msgid "Custom SPF source"
msgstr "Fuente SPF personalizada"

#: Bastion/includes/class-admin.php:571
msgid "Custom policy"
msgstr "Política personalizada"

#: Bastion/includes/class-admin.php:699 Bastion/includes/class-audit.php:487
msgid "DKIM"
msgstr "DKIM"

#: Bastion/includes/class-admin.php:700
msgid "DKIM is provider-specific: enable it in the mail provider’s console, publish the TXT record it gives you, and keep the private key where it is. No plugin can generate it for you."
msgstr "DKIM depende del proveedor: actívalo en su consola, publica el registro TXT que te dé y deja la clave privada donde está. Ningún plugin puede generarlo por ti."

#: Bastion/includes/class-admin.php:648
msgid "DMARC"
msgstr "DMARC"

#: Bastion/includes/class-audit.php:470 Bastion/includes/class-audit.php:472 Bastion/includes/class-audit.php:478
msgid "DMARC published"
msgstr "DMARC publicado"

#: Bastion/includes/class-admin.php:689
msgid "DMARC — TXT record at _dmarc.%s"
msgstr "DMARC — registro TXT en _dmarc.%s"

#: Bastion/includes/class-audit.php:730
msgid "Date"
msgstr "Fecha"

#: Bastion/includes/class-admin.php:482
msgid "Delete all plugin data when the plugin is deleted"
msgstr "Eliminar todos los datos del plugin al eliminarlo"

#: Bastion/includes/class-audit.php:579
msgid "Delete readme.html, or let Bastion answer 404 for it."
msgstr "Elimina readme.html, o deja que Bastion responda 404 por él."

#: Bastion/includes/class-admin.php:632
msgid "Determines the SPF include. Pre-selected when the MX record matches a known provider."
msgstr "Determina el include SPF. Se preselecciona cuando el registro MX coincide con un proveedor conocido."

#: Bastion/includes/class-admin.php:606
msgid "Disables a browser feature for the whole site. Empty to send nothing."
msgstr "Desactiva una función del navegador para todo el sitio. Vacío para no enviar nada."

#: Bastion/includes/class-admin.php:609 Bastion/includes/class-admin.php:720 Bastion/includes/class-audit.php:743
msgid "Disclosures"
msgstr "Divulgaciones"

#: Bastion/includes/class-admin.php:294
msgid "Dismiss"
msgstr "Descartar"

#: Bastion/includes/class-admin.php:122 Bastion/includes/class-admin.php:820
msgid "Documentation"
msgstr "Documentación"

#: Bastion/includes/class-admin.php:628 Bastion/includes/class-admin.php:630 Bastion/includes/class-audit.php:435
msgid "Domain"
msgstr "Dominio"

#: Bastion/includes/class-audit.php:443
msgid "Domain checked"
msgstr "Dominio comprobado"

#: Bastion/includes/class-admin.php:743
msgid "Download the report"
msgstr "Descargar el informe"

#: Bastion/includes/class-admin.php:500
msgid "Dry run: log instead of redirect"
msgstr "Simulación: registrar en lugar de redirigir"

#: Bastion/includes/class-admin.php:407 Bastion/includes/class-admin.php:719 Bastion/includes/class-audit.php:742
msgid "Email"
msgstr "Correo"

#: Bastion/includes/class-admin.php:486
msgid "Emergency disable"
msgstr "Desactivación de emergencia"

#: Bastion/includes/class-admin.php:433
msgid "Enable Bastion"
msgstr "Activar Bastion"

#: Bastion/includes/class-audit.php:490
msgid "Enable DKIM in your mail provider, then keep the key it gives you."
msgstr "Activa DKIM en tu proveedor de correo y guarda la clave que te dé."

#: Bastion/includes/class-admin.php:638
msgid "End of the SPF record"
msgstr "Final del registro SPF"

#: Bastion/includes/class-admin.php:553
msgid "Enforce"
msgstr "Aplicar (bloqueante)"

#: Bastion/includes/class-admin.php:535
msgid "Every subdomain must then serve HTTPS — including the ones you have forgotten."
msgstr "Cada subdominio debe servir HTTPS — incluidos los que has olvidado."

#: Bastion/includes/class-admin.php:753 Bastion/includes/class-audit.php:748
msgid "Evidence"
msgstr "Prueba"

#: Bastion/includes/class-audit.php:394
msgid "File types locked (nosniff)"
msgstr "Tipos de archivo bloqueados (nosniff)"

#: Bastion/includes/class-updater.php:163
msgid "Forces HTTPS, sets the security headers, closes the version leaks and audits the result on the live site — with nothing applied until you ask."
msgstr "Fuerza HTTPS, pone las cabeceras de seguridad, cierra las fugas de versión y audita el resultado en el sitio en vivo — sin aplicar nada hasta que lo pidas."

#: Bastion/includes/class-admin.php:578
msgid "Framing and the rest"
msgstr "Enmarcado y el resto"

#: Bastion/includes/class-admin.php:542
msgid "Framing, MIME sniffing, referrer, permissions and the policy below."
msgstr "Enmarcado, sniffing MIME, referrer, permisos y la política de abajo."

#: Bastion/includes/class-admin.php:525
msgid "HSTS"
msgstr "HSTS"

#: Bastion/includes/class-audit.php:324
msgid "HSTS is set"
msgstr "HSTS está puesto"

#: Bastion/includes/class-admin.php:405 Bastion/includes/class-admin.php:717 Bastion/includes/class-audit.php:740
msgid "HTTPS"
msgstr "HTTPS"

#: Bastion/includes/class-audit.php:274
msgid "HTTPS answers"
msgstr "El HTTPS responde"

#: Bastion/includes/class-admin.php:386
msgid "HTTPS, security headers, a domain that cannot be spoofed, and a report that proves it — measured on the live site, and reversible at every step."
msgstr "HTTPS, cabeceras de seguridad, un dominio que no se puede suplantar y un informe que lo demuestra — medido en el sitio en vivo y reversible en cada paso."

#: Bastion/includes/class-admin.php:406 Bastion/includes/class-admin.php:718 Bastion/includes/class-audit.php:741
msgid "Headers"
msgstr "Cabeceras"

#: Bastion/includes/class-admin.php:477 Bastion/includes/class-admin.php:798
msgid "Housekeeping"
msgstr "Mantenimiento"

#: Bastion/includes/class-audit.php:279
msgid "If the site has no certificate yet, this check cannot pass. Nothing is changed by the plugin until it does."
msgstr "Si el sitio aún no tiene certificado, esta comprobación no puede superarse. El plugin no cambia nada mientras tanto."

#: Bastion/includes/class-admin.php:535
msgid "Include subdomains"
msgstr "Incluir subdominios"

#: Bastion/includes/class-admin.php:607
msgid "Isolates the page from the windows it opens. Off by default: it breaks pop-up based sign-in (OAuth, some payment providers)."
msgstr "Aísla la página de las ventanas que abre. Desactivado por defecto: rompe el acceso por ventana emergente (OAuth, algunos proveedores de pago)."

#: Bastion/includes/class-admin.php:290
msgid "It measures and reports; nothing on the front end has been changed. Read the report, then switch to “Apply” when the failures make sense to you."
msgstr "Mide e informa; no se ha cambiado nada en el front. Lee el informe y pasa a «Aplicar» cuando los fallos te parezcan coherentes."

#: Bastion/includes/class-admin.php:451
msgid "It never edits wp-config.php, .htaccess or the theme. It never touches the database schema. It writes no file. Everything it does is a response header, a redirect, or a filter — and deactivating restores the previous behaviour instantly."
msgstr "Nunca modifica wp-config.php, .htaccess ni el tema. No toca el esquema de la base. No escribe ningún archivo. Todo lo que hace es una cabecera de respuesta, una redirección o un filtro — y al desactivarlo se restablece el comportamiento anterior al instante."

#: Bastion/includes/class-admin.php:481
msgid "Keep a small activity log"
msgstr "Mantener un pequeño registro de actividad"

#: Bastion/includes/class-admin.php:500
msgid "Keep this on for a day: the log shows what would have been redirected, and nothing breaks if the certificate is not ready."
msgstr "Déjalo activado un día: el registro muestra qué se habría redirigido, y nada se rompe si el certificado no está listo."

#: Bastion/includes/class-admin.php:454
msgid "Last measurement"
msgstr "Última medición"

#: Bastion/includes/class-admin.php:630
msgid "Leave empty to use the site host."
msgstr "Déjalo vacío para usar el host del sitio."

#: Bastion/includes/class-audit.php:407
msgid "Limits what the browser tells other sites about your URLs."
msgstr "Limita lo que el navegador cuenta a otros sitios sobre tus URL."

#: Bastion/includes/class-audit.php:311
msgid "Login screen is not served in clear text"
msgstr "La pantalla de acceso no se sirve en claro"

#: Bastion/includes/class-admin.php:632
msgid "Mail provider"
msgstr "Proveedor de correo"

#: Bastion/includes/class-admin.php:772
msgid "Markdown — copy it into an e-mail, a ticket or a client report"
msgstr "Markdown — para copiar en un correo, un ticket o un informe de cliente"

#: Bastion/includes/class-admin.php:534
msgid "Max-age (seconds)"
msgstr "Max-age (segundos)"

#: Bastion/includes/class-audit.php:554
msgid "Mixed content only exists on an HTTPS page. Move the site to HTTPS first."
msgstr "El contenido mixto solo existe en una página HTTPS. Pasa primero el sitio a HTTPS."

#: Bastion/includes/class-admin.php:435 Bastion/includes/class-admin.php:548
msgid "Mode"
msgstr "Modo"

#: Bastion/includes/class-audit.php:463
msgid "More than 10 DNS lookups: the record may be ignored by receivers."
msgstr "Más de 10 consultas DNS: los receptores pueden ignorar el registro."

#: Bastion/includes/class-admin.php:679
msgid "Name: @ — Type: TXT — Value above. One SPF record per domain, never two."
msgstr "Nombre: @ — Tipo: TXT — Valor de arriba. Un solo registro SPF por dominio, nunca dos."

#: Bastion/includes/class-admin.php:470
msgid "No audit has run yet. It is a read-only measurement: run it now, nothing will be changed."
msgstr "Todavía no se ha ejecutado ninguna auditoría. Es una medición de solo lectura: ejecútala, no se cambiará nada."

#: Bastion/includes/class-admin.php:706
msgid "No measurement yet"
msgstr "Aún no hay medición"

#: Bastion/includes/class-audit.php:547 Bastion/includes/class-audit.php:551 Bastion/includes/class-audit.php:559
msgid "No mixed content"
msgstr "Sin contenido mixto"

#: Bastion/includes/class-disclosure.php:239
msgid "Not found."
msgstr "No encontrado."

#: Bastion/includes/class-admin.php:426
msgid "Nothing is being changed: Bastion measures the site and reports. Switch to “Apply” when you are ready."
msgstr "No se está cambiando nada: Bastion mide el sitio e informa. Pasa a «Aplicar» cuando estés listo."

#: Bastion/includes/class-admin.php:782
msgid "Nothing logged yet. Bastion records what it did — a redirect it made, a file it blocked, a setting you saved."
msgstr "Nada en el registro. Bastion anota lo que hizo — una redirección, un archivo bloqueado, un ajuste guardado."

#: Bastion/includes/class-admin.php:382 Bastion/includes/class-admin.php:551 Bastion/includes/class-admin.php:587
msgid "Off"
msgstr "No"

#: Bastion/includes/class-admin.php:499
msgid "Off by default. Covers every front-end page and the login screen, including the password reset. Only GET and HEAD are redirected — a POST is never touched, because a 301 would turn it into a GET and silently lose the body of the form. The REST API and admin-ajax.php answer before this hook runs, so a JSON client is never bounced through a redirect. The port is kept, so a site on 8443 stays on 8443."
msgstr "Desactivado por defecto. Cubre todas las páginas del sitio y la pantalla de acceso, incluido el restablecimiento de contraseña. Solo se redirigen GET y HEAD — un POST nunca se toca, porque un 301 lo convertiría en GET y perdería el formulario en silencio. Los puntos de API (REST, admin-ajax) se dejan intactos a propósito: un cliente JSON no sigue una redirección como un navegador, y convertirla en GET lo rompe."

#: Bastion/includes/class-admin.php:433
msgid "Off removes every header, every redirect and every change, without touching a single option."
msgstr "Desactivado, quita cada cabecera, cada redirección y cada cambio, sin tocar una sola opción."

#: Bastion/includes/class-admin.php:522
msgid "One address or CIDR range per line. The forwarded scheme is only read when the direct peer is on this list — otherwise any visitor could claim to be on HTTPS."
msgstr "Una dirección o rango CIDR por línea. El esquema reenviado solo se lee si el par directo está en esta lista — si no, cualquier visitante podría decir que está en HTTPS."

#: Bastion/includes/class-admin.php:536
msgid "Only meaningful once the domain is submitted to the browser preload list. It requires “include subdomains”."
msgstr "Solo tiene sentido cuando el dominio se envía a la lista de precarga de los navegadores. Requiere «incluir subdominios»."

#: Bastion/includes/class-admin.php:533
msgid "Only sent over HTTPS. Off by default, and it cannot be undone quickly once browsers have seen it."
msgstr "Solo se envía por HTTPS. Desactivado por defecto, y no se puede deshacer rápido una vez que los navegadores lo han visto."

#: Bastion/includes/class-admin.php:517
msgid "Only when a CDN or a load balancer terminates TLS in front of the site. Without it, redirecting every request would loop for ever."
msgstr "Solo cuando un CDN o un balanceador termina el TLS delante del sitio. Sin ello, redirigir cada petición entraría en bucle."

#: Bastion/includes/class-admin.php:293
msgid "Open the report"
msgstr "Abrir el informe"

#: Bastion/includes/class-audit.php:416
msgid "Optional: disables camera, microphone and geolocation for the whole site."
msgstr "Opcional: desactiva cámara, micrófono y geolocalización para todo el sitio."

#: Bastion/includes/class-admin.php:482
msgid "Options, log and transients are removed. The plugin does nothing until you delete it."
msgstr "Se eliminan opciones, registro y transients. El plugin no hace nada hasta que lo borres."

#: Bastion/includes/class-admin.php:489
msgid "Or use WP-CLI:"
msgstr "O con WP-CLI:"

#: Bastion/includes/class-admin.php:634
msgid "Overrides the provider, for a relay that is not listed."
msgstr "Sustituye al proveedor, para un relé que no está en la lista."

#: Bastion/includes/class-admin.php:404
msgid "Overview"
msgstr "Resumen"

#: Bastion/includes/class-admin.php:663
msgid "Percentage"
msgstr "Porcentaje"

#: Bastion/includes/class-audit.php:412
msgid "Permissions policy"
msgstr "Política de permisos"

#: Bastion/includes/class-admin.php:606
msgid "Permissions-Policy"
msgstr "Permissions-Policy"

#: Bastion/includes/class-admin.php:560 Bastion/includes/class-admin.php:652
msgid "Policy"
msgstr "Política"

#: Bastion/includes/class-audit.php:454 Bastion/includes/class-audit.php:472
msgid "Publish the record below at your registrar."
msgstr "Publica el registro de abajo en tu registrador."

#: Bastion/includes/class-audit.php:369
msgid "Read the violations in the browser console, then switch the mode to “Enforce”."
msgstr "Lee las violaciones en la consola del navegador y pasa el modo a «Aplicar»."

#: Bastion/includes/class-admin.php:528
msgid "Read this before switching HSTS on"
msgstr "Léelo antes de activar HSTS"

#: Bastion/includes/class-admin.php:662
msgid "Receives the aggregate reports. A dedicated address is cleaner than a mailbox you read."
msgstr "Recibe los informes agregados. Una dirección dedicada es más limpia que un buzón que lees."

#: Bastion/includes/class-admin.php:497
msgid "Redirect"
msgstr "Redirección"

#: Bastion/includes/class-admin.php:594 Bastion/includes/class-audit.php:403
msgid "Referrer policy"
msgstr "Política de referrer"

#: Bastion/includes/class-admin.php:613
msgid "Remove RSD and WLW manifest links"
msgstr "Quitar los enlaces RSD y WLW manifest"

#: Bastion/includes/class-admin.php:615
msgid "Remove X-Pingback"
msgstr "Quitar X-Pingback"

#: Bastion/includes/class-admin.php:616
msgid "Remove X-Powered-By"
msgstr "Quitar X-Powered-By"

#: Bastion/includes/class-admin.php:614
msgid "Remove shortlink"
msgstr "Quitar el shortlink"

#: Bastion/includes/class-admin.php:612
msgid "Remove the ?ver= version"
msgstr "Quitar la versión del ?ver="

#: Bastion/includes/class-admin.php:611
msgid "Remove the generator meta"
msgstr "Quitar la etiqueta generator"

#: Bastion/includes/class-admin.php:614
msgid "Removes the shortlink tag and header."
msgstr "Quita la etiqueta y la cabecera shortlink."

#: Bastion/includes/class-admin.php:662
msgid "Report address"
msgstr "Dirección de informes"

